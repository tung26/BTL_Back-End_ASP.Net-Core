@model YourHouse.Application.DTOs.ArticleDto;
@using System.Text.Json

@{
	ViewData["Title"] = "Details";
	var commentsArticle = ViewBag.comments;
	ViewBag.IdUser = ViewBag.IdUser == null ? -1 : ViewBag.IdUser;
	var accAuthor = ViewBag.Acc;
	var like = !ViewBag.isLike ? "" : "liked";
}

<link href="~/css/article/detail.css" rel="stylesheet" />
<link href="~/fontawesome-free-6.7.2-web/css/all.css" rel="stylesheet" />
<link href="~/fontawesome-free-6.7.2-web/css/all.min.css" rel="stylesheet" />

<div class="toast-container position-fixed bottom-0 end-0 p-3">
	<div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="2500">
		<div class="toast-header">
			<strong class="me-auto">Thông báo</strong>
			<small id="toastTime"></small>
			<button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
		</div>
		<div class="toast-body" id="toastMessage">
		</div>
	</div>
</div>

<div class="row">
	<div class="col-8">
		<div class="container-fluid info_article">
			<div class="col">
				<img style="width: 100%;" src="@Model.ImagesArticles.ToList()[0].ImageArticle" />
			</div>
			<div class="col">

			</div>
			<div class="col">
				@if(ViewBag.IsLogin)
				{
					<button class="btn-likearticle mt-2 @like">
						<i class="fa-solid fa-heart"></i>
					</button>
				}
				<p>@Model.TypeAr</p>
				<p>Thời gian: @Model.CreateAt</p>
				<p>Tiêu đề: @Model.Title</p>
				<p>Chi tiết: @Model.DescAr</p>
				<p>@ViewBag.City - @ViewBag.District</p>
				<p>Địa chỉ chi tiết: @Model.Addr</p>
				<p>Diện tích: @Model.S</p>
				<p>Giá thuê: @Model.Price</p>
				<p>Tiền cọc: @Model.TienCoc</p>

				@{
					if (Model.Tro != null)
					{
						var tro = Model.Tro;
						<p>Tầng: @tro.Floor</p>
						<p>Người tối đa: @tro.MaxPerson</p>
						<p>Giá nước: @tro.WaterPrice</p>
						<p>Giá điện: @tro.ElectricPrice</p>
					}
					else if (Model.House != null)
					{
						var house = Model.House;
						<p>Phòng ngủ: @house.BedRoom</p>
						<p>Phòng vệ sinh: @house.BathRoom</p>
						<p>Số tầng: @house.Floors</p>
					}
					else if (Model.ChungCu != null)
					{
						var chungCu = Model.ChungCu;
						<p>Tầng: @chungCu.Floor</p>
						<p>Phòng ngủ: @chungCu.BedRoom</p>
						<p>Phòng vệ sinh: @chungCu.BathRoom</p>
						<p>Số người tối đa: @chungCu.MaxPerson</p>
						<p>Giá nước: @chungCu.WaterPrice</p>
						<p>Giá điện: @chungCu.ElectricPrice</p>
					}
					else if (Model.Office != null)
					{
						var off = Model.Office;
						<p>Tầng: @off.Floor</p>
						@if (off.Floor == 1)
						{
							<p>Hướng cửa chính: Đông</p>
						}
						else if (off.Floor == 2)
						{
							<p>Hướng cửa chính: Tây</p>
						}
						else if (off.Floor == 3)
						{
							<p>Hướng cửa chính: Nam</p>
						}
						else if (off.Floor == 4)
						{
							<p>Hướng cửa chính: Bắc</p>
						}
						else if (off.Floor == 5)
						{
							<p>Hướng cửa chính: Đông bắc</p>
						}
						else if (off.Floor == 6)
						{
							<p>Hướng cửa chính: Đông nam</p>
						}
						else if (off.Floor == 7)
						{
							<p>Hướng cửa chính: Tây bắc</p>
						}
						else if (off.Floor == 8)
						{
							<p>Hướng cửa chính: Tây nam</p>
						}
					}
				}
			</div>
		</div>
	</div>
	<div class="col-4">
		<div class="container-fluid acc_author">
			<div class="row">
				<button class="btn btn-outline-warning mb-2 btn-report-article">Bài viết có vấn đề</button>
				<p class="d-flex align-center justify-content-center" style="font-size: 18px">
					<a href="/Account/Index/@accAuthor.AccountId" class="nav me-1" style="">
						<img src="@accAuthor.ImageUser" style="width: 40px; height: 40px; border-radius: 50%; border: 1px solid #cecece;" />
					</a>
					@accAuthor.FullName
				</p>
				<button class="btn btn-primary" style="height: 50px; cursor: default;">@accAuthor.Phone</button>
				<p>@accAuthor.Email</p>
				@if (accAuthor.Facebook != null)
				{
					<a target="_blank" class="d-flex nav-item" style="text-decoration: none;" href="@accAuthor.Facebook">
						<i class="fa-brands fa-facebook" style="font-size: 30px;"></i>
						<p class="ms-1" style="font-size: 18px;">Liện hệ Facebook</p>
					</a>
				}
			</div>
		</div>
	</div>
</div>

<div class="row">
	<div class="header-comments alert alert-success" style="border: 1px solid #ccc;">
		<span>Bình luận</span>
	</div>
	<div class="body-comments">
		
	</div>
	<div class="mt-2">
		<div class="input-group">
			@if(ViewBag.IsLogin)
			{
				<input class="form-control" />
				 <button class="btn btn-outline-primary btn-send-comment">Send</button>
			}
 		</div> 
 	</div> 
 </div> 

<script>
	let comments = @Html.Raw(JsonSerializer.Serialize(commentsArticle));
	let btnSendComments = document.querySelectorAll(".btn-send-comment");
	let btnDeleteComments = document.querySelectorAll(".btn-delete-comment");
	const containerComment = document.querySelector(".body-comments");

	const btnReportArticle = document.querySelector(".btn-report-article");
	const btnToggleLikeArticle = document.querySelector(".btn-likearticle");

	btnToggleLikeArticle.onclick = () => {
		const isLike = btnToggleLikeArticle.classList.value.includes("liked");

		if(!isLike) {
			fetch(`/Administrator/LikeArticle/Add/@Model.ArticleId`)
				.then(repon => repon.json())
				.then(data => {
					if(data.success) {
						document.getElementById('toastMessage').textContent = data.message;
						let toastEl = document.getElementById('liveToast');
						let toast = new bootstrap.Toast(toastEl);
						toast.show();
						btnToggleLikeArticle.classList.add('liked');
					}
				});
		}
		else {
			fetch(`/Administrator/LikeArticle/Delete/@Model.ArticleId`, {
				method: "DELETE"
			})
				.then(repon => repon.json())
				.then(data => {
					if(data.success) {
						document.getElementById('toastMessage').textContent = data.message;
						let toastEl = document.getElementById('liveToast');
						let toast = new bootstrap.Toast(toastEl);
						toast.show();
						btnToggleLikeArticle.classList.remove('liked');
					}
				});
		}
	};

	btnReportArticle.onclick = () => {
		fetch("/Article/ReportArticle/@Model.ArticleId")
			.then(response => response.json())
			.then(data => {
				if(data.success) {
					document.getElementById('toastMessage').textContent = "Báo cáo đã được gửi";
					let toastEl = document.getElementById('liveToast');
					let toast = new bootstrap.Toast(toastEl);
					toast.show();
				}
				else {
					document.getElementById('toastMessage').textContent = "Báo cáo thất bại";
					let toastEl = document.getElementById('liveToast');
					let toast = new bootstrap.Toast(toastEl);
					toast.show();
				}
			});
	}

	function reloadBtnInputResponComments() {
		const btnInputResponComments = document.querySelectorAll(".btn-repon-comment");
		btnInputResponComments.forEach(btnInputResponComment => {
			btnInputResponComment.onclick = () => {
				let responComment = btnInputResponComment.parentElement.parentElement.querySelectorAll(".respon_comment");
				lastResponComment = responComment[responComment.length - 1];

				let allResponComment = document.querySelectorAll(".respon_comment");
				let responCommentLen = allResponComment.length;

				for(let i = 0; i < responCommentLen; i++) {
					if(allResponComment[i] == lastResponComment) continue;
					allResponComment[i].innerHTML = "";
				}

				lastResponComment.innerHTML = `
					<div class="user-comment">
						<img class="rounded-circle user-comment" src="https://cdn.pixabay.com/photo/2023/02/18/11/00/icon-7797704_640.png" />
					</div>
					<div class="input-group">
						<input class="form-control input_comment" />
						<button class="btn btn-outline-primary btn-send-comment">Send</button>
					</div>
				`
				btnSendComments = document.querySelectorAll(".btn-send-comment");

				btnSendComments.forEach(btnSendComment => {
					btnSendComment.onclick = () => {
						let inputCommentElement = btnSendComment.parentElement.querySelector('input');
						let ParentComment = btnSendComment.parentElement.parentElement.parentElement.parentElement;
						let value = inputCommentElement.value.trim();

						if(value != "") {
							if(ParentComment.getAttribute("data-id")) {
								postComment(content = value, ParentComment);
							}else {
								postComment(content = value, null);
							}
						}

						inputCommentElement.value = "";
					}
				});
			}
		});
	}

	function loadBtnResultCommentChild() {
		const btnResultCommentChilds = document.querySelectorAll(".result-response");

		btnResultCommentChilds.forEach(btnResultCommentChild => {
			btnResultCommentChild.onclick = () => {
				let commentParent = btnResultCommentChild.parentElement.parentElement.parentElement;
				let idParent = commentParent.getAttribute("data-id");
				let commentChild = commentParent.querySelector(".comment-childrent");
				let html = "";
				for(let i = 0; i < comments.length; i++) {
					let comment = comments[i];
					if(comment.ParentCommentId != idParent) continue;
					html += `
						<div class="comment" data-id="${comment.CommentId}">
							<div class="user-comment">
								<img class="rounded-circle user-comment" src="${comment.ImageUser}" />
							</div>
							<div class="container-comment">
								<div class="name-usercomment">${comment.UserName}</div>
								<div class="content-comment ${comment.IsDelete ? "comment_deleted" : ""}">
									${comment.IsDelete ? "Bình luận đã bị xóa !!!" : comment.Content}
								</div>
								<div class="more">
									<p class="time-comment">${comment.CreateAt}</p>
									<button class="result-response">Phản hồi</button>
										@if (ViewBag.IsLogin)
										{
												<button class="btn-repon-comment">trả lời</button>
										}
										${comment.AccountId == @ViewBag.IdUser ? '<button class="btn-delete-comment">xóa</button>' : ""}
								</div>

								<div class="comment-childrent">

								</div>

								<div class="respon_comment">

								</div>
							</div>
						</div>
					`
				}
				
				commentChild.innerHTML = html;
				reloadBtnInputResponComments();
				loadBtnResultCommentChild();
				loadBtnDeleteComment()
			}
		});
	}

	function loadComments() {
		let html = "";

		for(let i = 0; i < comments.length; i++) {
			let comment = comments[i];
			if(comment.ParentCommentId != null) continue;
			html += `
						<div class="comment" data-id="${comment.CommentId}">
							<div class="user-comment">
								<img class="rounded-circle user-comment" src="${comment.ImageUser}" />
							</div>
							<div class="container-comment">
								<div class="name-usercomment">${comment.UserName}</div>
								<div class="content-comment ${comment.IsDelete ? "comment_deleted" : ""}">
									${comment.IsDelete ? "Bình luận đã bị xóa !!!" : comment.Content}
								</div>
								<div class="more">
									<p class="time-comment">${comment.CreateAt}</p>
									<button class="result-response">Phản hồi</button>
										@if (ViewBag.IsLogin)
										{
											<button class="btn-repon-comment">trả lời</button>
										}
										${comment.AccountId == @ViewBag.IdUser || @ViewBag.RoleId ? '<button class="btn-delete-comment">xóa</button>' : ""}
								</div>

								<div class="comment-childrent">

								</div>

								<div class="respon_comment">

								</div>
							</div>
						</div>
					`

		}
		containerComment.innerHTML = html;

		loadBtnResultCommentChild();

		reloadBtnInputResponComments();
		loadBtnDeleteComment()
	}

	loadComments();

	reloadBtnInputResponComments()

	function loadBtnDeleteComment() {
		btnDeleteComments = document.querySelectorAll(".btn-delete-comment");
		btnDeleteComments.forEach(btnDeleteComment => {
			btnDeleteComment.onclick = () => {
				let id = btnDeleteComment.closest('.comment').getAttribute("data-id");
				handlerDeleteComment(id);
			}
		});
	}

	function handlerDeleteComment(id) {
		fetch(`/Comment/Delete?id=${id}`, {
			method: "DELETE"
		}).then(response => response.json())
		.then(data => {
			if(data.success) {
				let commentCur = document.querySelector(`.comment[data-id="${id}"]`);

				if(data.isvalid) {
					contentComment = commentCur.querySelector(".content-comment");
					contentComment.classList.add("comment_deleted");
					contentComment.innerHTML = "Bình luận đã bị xóa !!!"
				}
				else if (!data.isvalid) {
					const index = comments.findIndex(comment => comment.CommentId == id);
					if(index != -1) {
						comments.splice(index, 1);
					}
					commentCur.remove();
				}
			}
		})
	}

	function postComment(content, parentComment) {
		fetch("/Comment/Add", {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
				},
				body: JSON.stringify({
					ParentCommentId: parentComment != null ? parentComment.getAttribute("data-id") : null,
					AccountId: @{
						var idUser = ViewBag.IdUser != null ? ViewBag.IdUser : -1;

						@idUser
					},
					ArticleId: @Model.ArticleId,
					Content: content
				})
			})
			.then(respon => respon.json())
			.then(data => {
				if(data.success) {
					let htmlComment = `
						<div class="comment" data-id="${data.idComment}">
							<div class="user-comment">
								<img class="rounded-circle user-comment" src="@ViewBag.ImageUser" />
							</div>
							<div class="container-comment">
								<div class="name-usercomment">@ViewBag.UserName</div>
								<div class="content-comment">
									${content}
								</div>
								<div class="more">
									<p class="time-comment">${data.createAt}</p>
									@if (ViewBag.IsLogin)
									{
										<button class="btn-repon-comment">trả lời</button>
									}
									<button class="btn-delete-comment">xóa</button>
								</div>

								<div class="comment-childrent">

								</div>

								<div class="respon_comment">

								</div>
							</div>
						</div>
					`

					if(parentComment) {
						parentComment.querySelector(".comment-childrent").innerHTML = parentComment.querySelector(".comment-childrent").innerHTML + htmlComment;
					}
					else {
						containerComment.innerHTML = containerComment.innerHTML + htmlComment;
					}

					reloadBtnInputResponComments();
					loadBtnDeleteComment();
				}
			})
	}

	btnSendComments.forEach(btnSendComment => {
		btnSendComment.onclick = () => {
			let inputCommentElement = btnSendComment.parentElement.querySelector('input');
			let value = inputCommentElement.value.trim();

			if(value != "") {
				postComment(content = value);
			}

			inputCommentElement.value = "";
		}
	});
</script>
