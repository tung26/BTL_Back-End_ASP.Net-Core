@using System.Text.Json
@{
    ViewData["Title"] = "ArticleReport";
    var articleList = ViewData["articleList"] as IEnumerable<dynamic>;
    articleList = articleList.Reverse();
}

<div class="pagetitle">
    <h1>Article Manager</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active">Article</li>
        </ol>
    </nav>
</div><!-- End Page Title -->
<div class="row mb-3">
    <div class="col col-3">
        <select class="form-select select_type">
            <option selected value="All">Tất cả</option>
            <option value="Tro">Trọ</option>
            <option value="ChungCu">Chung cư</option>
            <option value="Office">Văn phòng</option>
            <option value="House">Nhà ở</option>
        </select>
    </div>
</div>
<div class="row">
    <div class="col">
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Loại</th>
                    <th>Tiêu đề</th>
                    <th>Địa chỉ</th>
                    <th>Diện tích</th>
                    <th>Giá</th>
                    <th>UpdateAt</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody class="body_table-article">
                @foreach (var item in articleList)
                {
                    <tr>
                        <td>@item.TypeAr</td>
                        <td>@item.Title</td>
                        <td>@item.city - @item.district</td>
                        <td>@item.S</td>
                        <td>@item.Price</td>
                        <td>@item.CreateAt</td>
                        <td class="d-flex">
                            <button type="button" class="btn btn-danger btn-delete ms-1" data-id="@item.ArticleId">Xóa</button>
                            <button type="button" class="btn btn-outline-danger btn-delete-report ms-1" data-id="@item.ArticleId">Xóa báo cáo</button>
                            <a asp-area="" asp-controller="Article" asp-action="Details" asp-route-id="@item.ArticleId" class="btn btn-success ms-1">Xem</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>

    let articleList = @Html.Raw(JsonSerializer.Serialize(articleList));
    const selectTypeElement = document.querySelector('.select_type');
    const bodyTableElement = document.querySelector('.body_table-article');

    selectTypeElement.onchange = () => {
        let valueType = selectTypeElement.value;

        let html = '';
        articleList.forEach(article => {
            if(article.TypeAr == valueType || valueType == "All") {
                html += `
                        <tr>
                            <td>${article.TypeAr}</td>
                            <td>${article.Title}</td>
                            <td>${article.city} - ${article.district}</td>
                            <td>${article.S}</td>
                            <td>${article.Price}</td>
                            <td>${article.CreateAt}</td>
                            <td class="d-flex">
                                <button type="button" class="btn btn-danger btn-delete ms-1" data-id="${article.ArticleId}">Xóa</button>
                                <button type="button" class="btn btn-outline-danger btn-delete-report ms-1" data-id="${article.ArticleId}">Xóa báo cáo</button>
                                <a asp-area="" asp-controller="Article" asp-action="Details" asp-route-id="${article.ArticleId}" class="btn btn-success ms-1">Xem</a>
                            </td>
                        </tr>
                `
            }
        });

        bodyTableElement.innerHTML = html;
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll(".btn-delete-report").forEach((btn) => {
            btn.addEventListener('click', function() {
                const idArticle = this.getAttribute('data-id');
                
                fetch(`/Administrator/Article/UnReport/${idArticle}`)
                    .then(reponse => reponse.json())
                    .then(data => {
                        if (data.success) {
                            this.closest('tr').remove();

                            document.getElementById('toastMessage').textContent = data.message;
                            let toastEl = document.getElementById('liveToast');
                            let toast = new bootstrap.Toast(toastEl);
                            toast.show();
                        }
                    })
            });
        });

        document.querySelectorAll('.btn-delete').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (!confirm('Bạn có chắc chắn muốn xóa bài đăng này?')) return;
                const articleId = this.getAttribute('data-id');


                fetch(`/Administrator/Article/Delete/?id=${articleId}`, {
                    method: 'DELETE',
                    headers: {
                        "Content-Type": "application/json",
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        this.closest('tr').remove();

                        document.getElementById('toastMessage').textContent = data.message;
                        let toastEl = document.getElementById('liveToast');
                        let toast = new bootstrap.Toast(toastEl);
                        toast.show();
                    } else {
                        document.getElementById('toastMessage').textContent = data.message;
                        let toastEl = document.getElementById('liveToast');
                        let toast = new bootstrap.Toast(toastEl);
                        toast.show();
                    }
                });
            });
        });
    });
</script>

