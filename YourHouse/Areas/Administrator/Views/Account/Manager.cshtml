@model List<YourHouse.Application.DTOs.AccountDto>
@{
    ViewData["Title"] = "Manager";
    Layout = "~/Areas/Administrator/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Accounts Manager</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active">Manager</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<div class="row">
    <div class="col">
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>SDT</th>
                    <th>Facebook</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var acc in Model)
                {
                    <tr>
                        <td>@acc.AccountId</td>
                        <td>@acc.FullName</td>
                        <td>@acc.Email</td>
                        <td>@acc.Phone</td>
                        <td><a href="@acc.Facebook" target="_blank">@acc.Facebook</a></td>
                        <td>
                            <button class="btn btn-outline-danger delete_account-btn" data-id="@acc.AccountId">Delete</button>
                            <a asp-area="" asp-controller="Account" asp-action="Index" asp-route-id="@acc.AccountId" class="btn btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.delete_account-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (!confirm('Bạn có chắc chắn muốn xóa tài khoản?')) return;

                let idUserDelete = btn.getAttribute("data-id");

                fetch(`/Administrator/Account/Delete/?id=${idUserDelete}`, {
                    method: 'DELETE',
                    headers: {
                        "Content-Type": "application/json",
                    }
                    })
                    .then(response => response.json())
                    .then(response => {
                         window.location.href = response.redirectUrl;
                })
            });
        });
    });
</script>
