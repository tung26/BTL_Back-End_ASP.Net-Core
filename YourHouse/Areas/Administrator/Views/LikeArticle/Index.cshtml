@using System.Text.Json
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Administrator/Views/Shared/_Layout.cshtml";
	var articleList = ViewData["articleList"] as IEnumerable<dynamic>;
	articleList = articleList.Reverse();
}

<link href="~/fontawesome-free-6.7.2-web/css/all.css" rel="stylesheet" />
<link href="~/fontawesome-free-6.7.2-web/css/all.min.css" rel="stylesheet" />
<link href="~/css/administrator/likearticle/index.css" rel="stylesheet" />

<div class="toast-container position-fixed bottom-0 end-0 p-3">
	<div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="1500">
		<div class="toast-header">
			<strong class="me-auto">Thông báo</strong>
			<small id="toastTime"></small>
			<button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
		</div>
		<div class="toast-body" id="toastMessage">
		</div>
	</div>
</div>

<div class="pagetitle">
	<h1>MyArticle</h1>
	<nav>
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="/">Home</a></li>
			<li class="breadcrumb-item active">Article</li>
			<li class="breadcrumb-item active">LikeArticle</li>
		</ol>
	</nav>
</div><!-- End Page Title -->
<div class="row">
	<div class="col col-3">
		<select class="form-select select_type">
			<option selected value="All">Tất cả</option>
			<option value="Tro">Trọ</option>
			<option value="ChungCu">Chung cư</option>
			<option value="Office">Văn phòng</option>
			<option value="House">Nhà ở</option>
		</select>
	</div>
</div>
<div class="row">
	<div class="col">
		<table class="table table-bordered table-hover">
			<thead>
				<tr>
					<th>Loại</th>
					<th>Tiêu đề</th>
					<th>Địa chỉ</th>
					<th>Diện tích</th>
					<th>Giá</th>
					<th>UpdateAt</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody class="body_table-article">
				@foreach (var item in articleList)
				{
					<tr>
						<td>@item.TypeAr</td>
						<td>@item.Title</td>
						<td>@item.city - @item.district</td>
						<td>@item.S</td>
						<td>@item.Price</td>
						<td>@item.CreateAt</td>
						<td class="d-flex">
							<button class="btn-likearticle liked" data-id="@item.ArticleId"><i class="fa-solid fa-heart"></i></button>
							<a asp-area="" asp-controller="Article" asp-action="Details" asp-route-id="@item.ArticleId" class="btn btn-success ms-1">Xem</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>

<script>
	let articleList = @Html.Raw(JsonSerializer.Serialize(articleList));
	const selectTypeElement = document.querySelector('.select_type');
	const bodyTableElement = document.querySelector('.body_table-article');

	selectTypeElement.onchange = () => {
		let valueType = selectTypeElement.value;

		let html = '';
		articleList.forEach(article => {
			if(article.TypeAr == valueType || valueType == "All") {
				html += `
						<tr>
							<td>${article.TypeAr}</td>
							<td>${article.Title}</td>
							<td>${article.city} - ${article.district}</td>
							<td>${article.S}</td>
							<td>${article.Price}</td>
							<td>${article.CreateAt}</td>
							<td class="d-flex">
								<button class="btn-likearticle liked" data-id="${article.ArticleId}"><i class="fa-solid fa-heart"></i></button>
								<a asp-area="" asp-controller="Article" asp-action="Details" asp-route-id="${article.ArticleId}" class="btn btn-success ms-1">Xem</a>
							</td>
						</tr>
				`
			}
		});

		bodyTableElement.innerHTML = html;
	}

	const btnToggleLikeArticle = document.querySelector(".btn-likearticle");

	btnToggleLikeArticle.onclick = () => {
		const isLike = btnToggleLikeArticle.classList.value.includes("liked");

		const ArticleId = btnToggleLikeArticle.getAttribute("data-id");

		if(!isLike) {
			fetch(`/Administrator/LikeArticle/Add/${ArticleId}`)
				.then(repon => repon.json())
				.then(data => {
					if(data.success) {
						document.getElementById('toastMessage').textContent = data.message;
						let toastEl = document.getElementById('liveToast');
						let toast = new bootstrap.Toast(toastEl);
						toast.show();
						btnToggleLikeArticle.classList.add('liked');
					}
				});
		}
		else {
			fetch(`/Administrator/LikeArticle/Delete/${ArticleId}`, {
				method: "DELETE"
			})
				.then(repon => repon.json())
				.then(data => {
					if(data.success) {
						document.getElementById('toastMessage').textContent = data.message;
						let toastEl = document.getElementById('liveToast');
						let toast = new bootstrap.Toast(toastEl);
						toast.show();
						btnToggleLikeArticle.classList.remove('liked');
					}
				});
		}
	};
</script>

